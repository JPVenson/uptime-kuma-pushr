<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <Authors>Venson</Authors>
    <Description>A relay for monitors with Kuma-Uptime</Description>
    <Copyright>Jean-Pierre Bachmann</Copyright>
    <PackageProjectUrl>https://github.com/JPVenson/uptime-kuma-pushr</PackageProjectUrl>
    <RepositoryUrl>https://github.com/JPVenson/uptime-kuma-pushr</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageTags>uptime-kuma</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Cyotek.CircularBuffer" Version="1.2.1" />
    <PackageReference Include="MailKit" Version="4.8.0" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.Server" Version="10.0.9" />
    <PackageReference Include="NetServiceLocator" Version="1.2.0" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
    <PackageReference Include="DnsClient" Version="1.8.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\UptimeKuma.Pushr.BlazorUi\UptimeKuma.Pushr.BlazorUi.csproj" />
  </ItemGroup>

</Project>
